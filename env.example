# 复制成 .env 后填自己的 key
#   Windows:  copy env.example .env
#   macOS/Linux:  cp env.example .env
# 注意：.env 已经在 .gitignore 里，不会被提交

# ============ 必填：模型 API ============
# 阿里云百炼，用于 embedding 和 rerank
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
# DeepSeek，用于生成答案
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ============ 模型配置 ============
# 和你的学习笔记保持一致；换成你环境里实际可用的模型名
LLM_MODEL=deepseek-flash
EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024
RERANK_MODEL=gte-rerank-v2
RERANK_ENABLED=true

# 如果你的模型走的是自建网关/中转，把 base_url 填上（OpenAI 兼容协议）
# LLM_BASE_URL=http://127.0.0.1:8000/v1

# ============ 基础设施 ============
MILVUS_URI=http://127.0.0.1:19530
# 有鉴权的 Milvus 才需要
# MILVUS_TOKEN=root:Milvus
# 业务库：默认 SQLite，零配置；要上 PostgreSQL 就换成下面这行
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/rag
DATABASE_URL=sqlite:///data/rag.db

# ============ 检索参数 ============
# 下面几个数不是拍脑袋定的，是用 scripts/calibrate.py 在真实文档上量出来的：
#   同领域问题最高分 0.30 ~ 0.61
#   无关问题最高分   0.006
# 换了 embedding/rerank 模型后，这个分布会变，记得重新跑一次 calibrate.py
CHUNK_SIZE=900
CHUNK_MIN_SIZE=120
TOP_K_DENSE=10
TOP_K_SPARSE=10
TOP_K_CANDIDATE=14
TOP_K_FINAL=5
# 单条候选的入场券：低于它直接丢掉，不进 prompt
MIN_RERANK_SCORE=0.02
# 「检索够不够好」的判断线：低于它触发扩写重查（多花一次 LLM 调用）
SCORE_THRESHOLD=0.15
MAX_RETRY=1

# ============ 可选项 ============
# MinerU 的 token，填了就走 MinerU 解析 PDF（带 OCR），不填用 pypdf 兜底
# MINERU_TOKEN=
